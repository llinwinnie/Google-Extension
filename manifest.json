{
    "name": "dailydo",
    "version": "0.1",
    "manifest_version": 3,
    "description": "A Winnie‐the‐Pooh themed new tab page with clock, weather, quotes, news, to‐do, and calculator.",
    "action": {
      "default_popup": "hello.html",
      "default_icon": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  } 
    },
    "chrome_url_overrides" : {
        "newtab": "index.html"
    },
    "background": {
    "service_worker": "services/bg.js"
   },
    "permissions": [
      "storage",
      "alarms",
      "geolocation",
      "notifications",
      "tabs",
      "identity",
      "history"
    ],
    "host_permissions": [
      "https://feeds.bbci.co.uk/*",
      "https://api.open-meteo.com/*",
      "https://api.quotable.io/*",
      "https://nominatim.openstreetmap.org/*",
      "https://api.bigdatacloud.net/*"
  ]
}