{
    "name": "dailydo",
    "version": "0.1",
    "manifest_version": 3,
    "description": "A lightweight “new tab”‐style popup with weather, quotes, to-do, and quick links.",
    "action": {
      "default_popup": "hello.html",
      "default_icon": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  } 
    },
    "chrome_url_overrides" : {
        "newtab": "index.html"
    },
    "background": {
    "service_worker": "services/bg.js"
   },
    "permissions": [
      "storage",
      "geolocation",
      "tabs",
      "notifications",
      "alarms"
    ],
    "host_permissions": [
    "https://feeds.bbci.co.uk/*",
    "https://api.openweathermap.org/*",
    "https://api.quotable.io/*",
    "https://api.open-meteo.com/*"
  ]
}

     